@model RaceDay.MVC.Models.EventViewModel

@{
    ViewData["Title"] = "Delete Event";
}

<div class="container mt-4">
    <div class="card shadow border-danger">
        <div class="card-header bg-danger text-white">
            <h2>Delete Event</h2>
        </div>

        <div class="card-body">
            <h4>Are you sure you want to delete this event?</h4>

            <hr />

            <dl class="row">
                <dt class="col-sm-3">Event Name</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.Description</dd>

                <dt class="col-sm-3">Date</dt>
                <dd class="col-sm-9">@Model.EventDate.ToString("dd MMMM yyyy HH:mm")</dd>

                <dt class="col-sm-3">Location</dt>
                <dd class="col-sm-9">@Model.Location</dd>

                <dt class="col-sm-3">Distance</dt>
                <dd class="col-sm-9">@Model.DistanceKm km</dd>

                <dt class="col-sm-3">Event Type</dt>
                <dd class="col-sm-9">@Model.EventType</dd>
            </dl>

            <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()

                <button type="submit" class="btn btn-danger">
                    Yes, Delete Event
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>