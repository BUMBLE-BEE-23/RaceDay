
@model List<RaceDay.MVC.Models.CategoryViewModel>

@{
    ViewData["Title"] = "Event Categories";
    int eventId = (int)ViewBag.EventId;
    bool isOrganiser = Context.Session.GetString("Role") == "Organiser";
}

<div class="container mt-4">

    <div class="p-4 mb-4 bg-dark text-white rounded-3 shadow">
        <h1 class="fw-bold">Race Categories</h1>
        <p class="mb-0">Choose the right category for every participant.</p>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Available Categories</h2>

        @if (isOrganiser)
        {
            <a asp-action="Create"
               asp-route-eventId="@eventId"
               class="btn btn-primary">
                Add Category
            </a>
        }
    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            No categories have been added to this event yet.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var category in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card shadow h-100">
                        <div class="card-body">

                            <span class="badge bg-primary mb-2">
                                @category.CategoryType
                            </span>

                            <h4>@category.Name</h4>

                            @if (category.CategoryType == "Age")
                            {
                                <p>
                                    <strong>Age range:</strong>
                                    @category.MinimumAge - @category.MaximumAge years
                                </p>
                            }
                            else
                            {
                                <p>
                                    <strong>Distance:</strong>
                                    @category.DistanceKm KM
                                </p>
                            }

                            @if (isOrganiser)
                            {
                                <div class="d-flex gap-2 mt-3">

                                    <a asp-action="Edit"
                                       asp-route-id="@category.Id"
                                       asp-route-eventId="@eventId"
                                       class="btn btn-warning flex-fill">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@category.Id"
                                       asp-route-eventId="@eventId"
                                       class="btn btn-danger flex-fill">
                                        Delete
                                    </a>

                                </div>
                            }

                        </div>
                    </div>
                </div>
            }

        </div>
    }

    <div class="mt-4">
        <a asp-controller="Events"
           asp-action="Details"
           asp-route-id="@eventId"
           class="btn btn-secondary">
            Back to Event
        </a>
    </div>

</div>
