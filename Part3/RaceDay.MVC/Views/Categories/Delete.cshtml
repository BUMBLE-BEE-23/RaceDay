
@model RaceDay.MVC.Models.CategoryViewModel

@{
    ViewData["Title"] = "Delete Category";
}

<div class="container mt-4">
    <div class="card shadow border-danger">

        <div class="card-header bg-danger text-white">
            <h2>Delete Race Category</h2>
        </div>

        <div class="card-body">

            <h4>Are you sure you want to delete this category?</h4>

            <hr />

            <dl class="row">
                <dt class="col-sm-4">Category Name</dt>
                <dd class="col-sm-8">@Model.Name</dd>

                <dt class="col-sm-4">Category Type</dt>
                <dd class="col-sm-8">@Model.CategoryType</dd>

                @if (Model.CategoryType == "Age")
                {
                    <dt class="col-sm-4">Minimum Age</dt>
                    <dd class="col-sm-8">@Model.MinimumAge</dd>

                    <dt class="col-sm-4">Maximum Age</dt>
                    <dd class="col-sm-8">@Model.MaximumAge</dd>
                }
                else
                {
                    <dt class="col-sm-4">Distance</dt>
                    <dd class="col-sm-8">@Model.DistanceKm KM</dd>
                }
            </dl>

            <form asp-action="DeleteConfirmed"
                  asp-route-id="@Model.Id"
                  asp-route-eventId="@Model.EventId"
                  method="post">

                @Html.AntiForgeryToken()

                <button type="submit" class="btn btn-danger">
                    Yes, Delete Category
                </button>

                <a asp-action="Index"
                   asp-route-eventId="@Model.EventId"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>
    </div>
</div>
