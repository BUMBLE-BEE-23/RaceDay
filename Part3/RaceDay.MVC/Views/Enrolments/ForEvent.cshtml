 @model List<RaceDay.MVC.Models.EnrolmentViewModel>

@{
    ViewData["Title"] = "Enrolled Participants";
}

<div class="container mt-4">
    <h2>Enrolled Participants</h2>

    <p>Participants registered for this event. You can confirm or cancel each enrolment below.</p>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }
    else if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No participants have enrolled in this event yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Participant</th>
                        <th>Category</th>
                        <th>Enrolment Date</th>
                        <th>Status</th>
                        <th>Manage Enrolment</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var enrolment in Model)
                    {
                        var statusClass = enrolment.Status switch
                        {
                            "Confirmed" => "bg-success",
                            "Cancelled" => "bg-danger",
                            _ => "bg-warning text-dark"
                        };

                        <tr>
                            <td>@enrolment.ParticipantName</td>
                            <td>@enrolment.CategoryName</td>
                            <td>
                                @enrolment.EnrolledUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                            </td>
                            <td>
                                <span class="badge @statusClass">
                                    @enrolment.Status
                                </span>
                            </td>
                            <td>
                                @if (enrolment.Status != "Confirmed")
                                {
                                    <form asp-controller="Enrolments"
                                          asp-action="UpdateStatus"
                                          method="post"
                                          class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="enrolmentId" value="@enrolment.Id" />
                                        <input type="hidden" name="eventId" value="@enrolment.EventId" />
                                        <input type="hidden" name="status" value="Confirmed" />

                                        <button type="submit"
                                                class="btn btn-success btn-sm">
                                            Confirm
                                        </button>
                                    </form>
                                }

                                @if (enrolment.Status != "Cancelled")
                                {
                                    <form asp-controller="Enrolments"
                                          asp-action="UpdateStatus"
                                          method="post"
                                          class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="enrolmentId" value="@enrolment.Id" />
                                        <input type="hidden" name="eventId" value="@enrolment.EventId" />
                                        <input type="hidden" name="status" value="Cancelled" />

                                        <button type="submit"
                                                class="btn btn-danger btn-sm">
                                            Cancel
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <a asp-controller="Enrolments"
       asp-action="Index"
       class="btn btn-secondary">
        Back to Events
    </a>
</div>