
@model List<RaceDay.MVC.Models.EnrolmentViewModel>

@{
    ViewData["Title"] = "Enrolled Participants";
}

<div class="container mt-4">
    <h2>Enrolled Participants</h2>

    <p>Participants registered for this event.</p>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }
    else if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No participants have enrolled in this event yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>Participant</th>
                        <th>Category</th>
                        <th>Enrolment Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var enrolment in Model)
                    {
                        <tr>
                            <td>@enrolment.ParticipantName</td>
                            <td>@enrolment.CategoryName</td>
                            <td>@enrolment.EnrolledUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <a asp-controller="Enrolments"
       asp-action="Index"
       class="btn btn-secondary">
        Back to Events
    </a>
</div>
