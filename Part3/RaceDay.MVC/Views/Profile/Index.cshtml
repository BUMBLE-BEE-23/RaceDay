
@model RaceDay.MVC.Models.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";

    var pictureUrl = Model.ProfilePictureUrl
        ?? "/images/default-profile.png";
}

<div class="container mt-4">

    <div class="p-4 mb-4 bg-dark text-white rounded-3 shadow">
        <h1 class="display-6 fw-bold">My Profile</h1>
        <p class="fs-5 mb-0">
            View and update your personal account information.
        </p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Account Information</h5>
        </div>

        <div class="card-body">

            <form asp-controller="Profile"
                  asp-action="Index"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="text-center mb-4">

                    <img src="@pictureUrl"
                         alt="Profile picture"
                         class="rounded-circle border shadow"
                         style="width:150px;height:150px;object-fit:cover;"
                         onerror="this.onerror=null;this.src='/images/default-profile.png';" />

                    <div class="mt-3">
                        <label asp-for="ProfilePicture"
                               class="form-label fw-bold">
                            Upload Profile Picture
                        </label>

                        <input asp-for="ProfilePicture"
                               type="file"
                               class="form-control"
                               accept=".jpg,.jpeg,.png,.webp" />

                        <span asp-validation-for="ProfilePicture"
                              class="text-danger"></span>

                        <small class="text-muted">
                            JPG, JPEG, PNG or WebP. Maximum size: 5 MB.
                        </small>
                    </div>

                </div>

                <div class="mb-3">
                    <label asp-for="FirstName"
                           class="form-label"></label>

                    <input asp-for="FirstName"
                           class="form-control" />

                    <span asp-validation-for="FirstName"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="LastName"
                           class="form-label"></label>

                    <input asp-for="LastName"
                           class="form-control" />

                    <span asp-validation-for="LastName"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email"
                           class="form-label"></label>

                    <input asp-for="Email"
                           class="form-control"
                           readonly />
                </div>

                <div class="mb-3">
                    <label asp-for="PhoneNumber"
                           class="form-label"></label>

                    <input asp-for="PhoneNumber"
                           class="form-control" />

                    <span asp-validation-for="PhoneNumber"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Account Role</label>

                    <input asp-for="Role"
                           class="form-control"
                           readonly />
                </div>

                <button type="submit"
                        class="btn btn-success">
                    Save Profile
                </button>

                @if (Model.Role == "Organiser")
                {
                    <a asp-controller="Organiser"
                       asp-action="Dashboard"
                       class="btn btn-secondary">
                        Back to Dashboard
                    </a>
                }
                else
                {
                    <a asp-controller="Participant"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Back to Dashboard
                    </a>
                }

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
