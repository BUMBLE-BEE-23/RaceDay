
@model List<RaceDay.MVC.Models.ResultViewModel>

@{
    ViewData["Title"] = "Manage Race Results";
}

<div class="container mt-4">
    <h2>Manage Race Results</h2>

    <h5 class="text-muted">
        Event: @(ViewBag.EventName ?? "Selected Event")
    </h5>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No participants have enrolled in this event yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Participant</th>
                        <th>Finishing Position</th>
                        <th>Finish Time</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var result in Model)
                    {
                        <tr>
                            <td>@result.ParticipantName</td>

                            <td colspan="3">
                                <form asp-controller="Results"
                                      asp-action="Record"
                                      method="post"
                                      class="row g-2 align-items-center">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="EventId"
                                           value="@result.EventId" />

                                    <input type="hidden"
                                           name="EnrolmentId"
                                           value="@result.EnrolmentId" />

                                    <input type="hidden"
                                           name="ParticipantId"
                                           value="@result.ParticipantId" />

                                    <div class="col-md-3">
                                        <input type="number"
                                               name="FinishingPosition"
                                               value="@result.FinishingPosition"
                                               min="1"
                                               required
                                               class="form-control"
                                               placeholder="Position" />
                                    </div>

                                    <div class="col-md-5">
                                        <input type="time"
                                               name="FinishTime"
                                               step="1"
                                               value="@(result.FinishTime == TimeSpan.Zero ? "" : result.FinishTime.ToString(@"hh\:mm\:ss"))"
                                               required
                                               class="form-control" />
                                    </div>

                                    <div class="col-md-4">
                                        <button type="submit"
                                                class="btn btn-success w-100">
                                            Save Result
                                        </button>
                                    </div>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <a asp-controller="Results"
       asp-action="Index"
       class="btn btn-secondary">
        Back to Events
    </a>
</div>
