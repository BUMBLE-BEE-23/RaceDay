
@model List<RaceDay.MVC.Models.ResultViewModel>

@{
    ViewData["Title"] = "My Race Results";
}

<div class="container mt-4">

    <h2>My Race Results</h2>

    <p class="text-muted">
        View your finishing positions and recorded times.
    </p>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            You don't have any race results yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>Event</th>
                        <th>Finishing Position</th>
                        <th>Finish Time</th>
                        <th>Recorded Date</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var result in Model.OrderBy(x => x.FinishingPosition))
                    {
                        <tr>
                            <td>@result.EventName</td>
                            <td>
                                <strong>@result.FinishingPosition</strong>
                            </td>
                            <td>
                                @result.FinishTime.ToString(@"hh\:mm\:ss")
                            </td>
                            <td>
                                @result.RecordedUtc.ToLocalTime().ToString("dd MMM yyyy")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <a asp-controller="Events"
       asp-action="Index"
       class="btn btn-secondary">
        Back to Events
    </a>

</div>
